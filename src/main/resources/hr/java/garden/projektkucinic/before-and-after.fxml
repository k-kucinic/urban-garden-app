<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.java.garden.projektkucinic.controllers.BeforeAndAfterController">
    <children>
        <fx:include source="menubar.fxml"/>
        <HBox layoutX="21.0" layoutY="110.0" prefHeight="260.0" prefWidth="560.0">
            <children>
                <TableView fx:id="tableViewBefore" prefHeight="262.0" prefWidth="177.0">
                    <columns>
                        <TableColumn fx:id="plantBeforeColumn" prefWidth="180.0" text="BEFORE"/>
                    </columns>
                </TableView>
                <TableView fx:id="tableViewAfter" prefHeight="260.0" prefWidth="380.0">
                    <columns>
                        <TableColumn fx:id="plantAfterColumn" prefWidth="95.0" text="AFTER"/>
                        <TableColumn fx:id="userTableColumn" prefWidth="95.0" text="ROLE"/>
                        <TableColumn fx:id="dateOfChangeColumn" prefWidth="95.0" text="DATE"/>
                        <TableColumn fx:id="timeOfChangeColumn" prefWidth="95.0" text="TIME"/>
                    </columns>
                </TableView>
            </children>
        </HBox>
        <ButtonBar layoutX="377.0" layoutY="56.0" prefHeight="40.0" prefWidth="200.0">
            <buttons>
                <Button mnemonicParsing="false" onAction="#changedPlants" text="CHANGES"/>
                <Button mnemonicParsing="false" onAction="#deletedPlants" text="DELETED"/>
            </buttons>
        </ButtonBar>
    </children>
</AnchorPane>
