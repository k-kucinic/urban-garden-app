<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.java.garden.projektkucinic.controllers.PlantANewPlantController">
    <fx:include source="menubar.fxml"/>
    <GridPane layoutX="16.0" layoutY="74.0" prefHeight="327.0" prefWidth="578.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="292.800048828125" minWidth="10.0"
                               prefWidth="189.5999755859375"/>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="460.0" minWidth="10.0" prefWidth="411.20002441406245"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <children>
            <Label text="Plant Name" GridPane.halignment="RIGHT">
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <Label text="Plant Type" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <Label text="Required Space" GridPane.halignment="RIGHT" GridPane.rowIndex="3">
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <Label text="Planting date" GridPane.halignment="RIGHT" GridPane.rowIndex="2">
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <Label text="Watering Frequency (in days)" GridPane.halignment="RIGHT" GridPane.rowIndex="5">
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <Label text="Water per watering (L)" GridPane.halignment="RIGHT" GridPane.rowIndex="4">
                <GridPane.margin>
                    <Insets/>
                </GridPane.margin>
                <padding>
                    <Insets right="20.0"/>
                </padding>
            </Label>
            <TextField fx:id="plantNameTextField" GridPane.columnIndex="1">
                <GridPane.margin>
                    <Insets left="20.0" right="20.0"/>
                </GridPane.margin>
            </TextField>
            <ComboBox fx:id="plantTypeComboBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                      GridPane.rowIndex="1"/>
            <DatePicker fx:id="plantingDatePicker" GridPane.columnIndex="1" GridPane.halignment="CENTER"
                        GridPane.rowIndex="2"/>
            <TextField fx:id="requiredSpaceTextField" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <GridPane.margin>
                    <Insets left="20.0" right="20.0"/>
                </GridPane.margin>
            </TextField>
            <TextField fx:id="waterNeededTextField" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <GridPane.margin>
                    <Insets left="20.0" right="20.0"/>
                </GridPane.margin>
            </TextField>
            <TextField fx:id="wateringFrequencyTextField" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <GridPane.margin>
                    <Insets left="20.0" right="20.0"/>
                </GridPane.margin>
            </TextField>
            <Button mnemonicParsing="false" onAction="#newPlant" text="Save" GridPane.columnSpan="2"
                    GridPane.halignment="CENTER" GridPane.rowIndex="6"/>
        </children>
    </GridPane>
    <Label layoutX="239.0" layoutY="35.0" text="Add a New Plant">
        <font>
            <Font size="22.0"/>
        </font>
    </Label>

</AnchorPane>
