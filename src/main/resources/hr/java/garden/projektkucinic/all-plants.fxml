<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.java.garden.projektkucinic.controllers.AllPlantsController">

    <children>
        <fx:include source="menubar.fxml"/>
        <GridPane layoutY="40.0" prefHeight="360.0" prefWidth="600.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <TableView fx:id="plantTableView" prefHeight="200.0" prefWidth="200.0"
                           style="-fx-background-color: #a0f2b6;" GridPane.columnSpan="2" GridPane.rowIndex="4"
                           GridPane.rowSpan="3">
                    <columns>
                        <TableColumn fx:id="plantNameTableColumn" maxWidth="150.0" prefWidth="120.0" resizable="false"
                                     text="Name"/>
                        <TableColumn fx:id="plantTypeTableColumn" prefWidth="120.0" resizable="false"
                                     text="Type of Plant"/>
                        <TableColumn fx:id="plantingDateStringTableColumn" prefWidth="120.0" resizable="false"
                                     text="Date of Planting"/>
                        <TableColumn fx:id="wateringFrequencyTableColumn" maxWidth="1.7976931348623157E308"
                                     prefWidth="120.0" resizable="false" text="Watering frequency"/>
                        <TableColumn prefWidth="120.0" fx:id="nextWateringDaysTableColumn" text="Next Watering"/>
                    </columns>
                    <contextMenu>
                        <ContextMenu fx:id="contextMenu">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#deletePlant" text="Delete"/>
                                <MenuItem mnemonicParsing="false" onAction="#editPlant" text="Edit"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
                <Label text="All plants in The Garden" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
                <Button mnemonicParsing="false" onAction="#search"
                        style="-fx-background-color: a0f2b6; -fx-border-color: white;" text="Search"
                        GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="3">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Button>
                <Label text="Enter name" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets right="20.0"/>
                    </GridPane.margin>
                </Label>
                <Label text="Choose type" GridPane.halignment="RIGHT" GridPane.rowIndex="2">
                    <GridPane.margin>
                        <Insets right="20.0"/>
                    </GridPane.margin>
                </Label>
                <ComboBox fx:id="plantTypeComboBoxString" prefWidth="150.0" GridPane.columnIndex="1"
                          GridPane.halignment="CENTER" GridPane.rowIndex="2"/>
                <TextField fx:id="plantNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <GridPane.margin>
                        <Insets left="29.0" right="20.0"/>
                    </GridPane.margin>
                </TextField>
            </children>
        </GridPane>
    </children>
</AnchorPane>
